#!/bin/sh
#ddev-generated
# Worktrunk pre-remove (blocking): on failure wt keeps the worktree, no orphaned DDEV project.
# Only a name from pre-start: without it the worktree resolves to the main project's name and ddev delete
# would wipe the main checkout's database.
grep -qs '^# generated by .ddev/worktree/pre-start' .ddev/config.local.yaml || exit 0
ddev delete -Oy
