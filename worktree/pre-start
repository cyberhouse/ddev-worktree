#!/bin/sh
#ddev-generated
# Worktrunk pre-start: gives a new worktree its own DDEV project in .ddev/config.local.yaml.
# Worktree created without wt: run `wt hook pre-start` in it.
# Name: project + ticket of the branch (feature/PROJ-5-x → myproject-proj-5),
# without a ticket project + branch.
# TLD: the rest of the name in front of the project's TLD (proj-5.dev.example.com), so the worktree serves
# every host of the main checkout under it and the main checkout's hosts stay as they are.
set -eu

local=.ddev/config.local.yaml
marker='# generated by .ddev/worktree/pre-start'

# Only in a worktree (in the main checkout .git is a directory) with DDEV.
if [ ! -f .git ] || [ ! -f .ddev/config.yaml ]; then
    exit 0
fi

# Never rename an existing worktree: its database belongs to the name.
# A file of an older add-on version (no project_tld) gets the TLD, with the same name.
upgrade=
if [ -f "$local" ]; then
    if grep -qs "^$marker" "$local" && ! grep -qs '^project_tld:' "$local"; then
        upgrade=$(sed -n 's/^name: *//p' "$local")
    fi
    if [ -z "$upgrade" ]; then
        exit 0
    fi
fi

# value of a top-level key in .ddev/config.yaml, without quotes and comment
config_value() {
    sed -n "s/^$1: *//p" .ddev/config.yaml | sed 's/ *#.*//' | tr -d "\"'"
}

project=$(config_value name)
if [ -z "$project" ]; then
    echo "worktree pre-start: .ddev/config.yaml has no name:, the worktree names are built from it" >&2
    exit 1
fi
base_tld=$(config_value project_tld)
base_tld=${base_tld:-ddev.site}

# DDEV name: lowercase, only a-z, 0-9 and -, max 63 chars
slug() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-'
}
make_name() {
    slug "$project-$1" | cut -c 1-63 | sed 's/-*$//'
}

if [ -n "$upgrade" ]; then
    name=$upgrade
else
    branch=$(git branch --show-current)
    if [ -z "$branch" ]; then
        # detached HEAD
        branch=$(basename "$PWD")
    fi
    ticket=$(echo "$branch" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -n 1)

    # config.local.yaml of all worktrees, to find names already in use
    used=$(git worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r dir; do
        if [ -f "$dir/$local" ]; then
            cat "$dir/$local"
        fi
    done)

    name=$(make_name "${ticket:-$branch}")

    # Same ticket in a second branch: use the whole branch. With a shared name
    # `wt remove` of one worktree would delete the database of the other.
    if echo "$used" | grep -qxF "name: $name"; then
        name=$(make_name "$branch")
    fi
    if echo "$used" | grep -qxF "name: $name"; then
        echo "worktree pre-start: DDEV name $name is taken by another worktree" >&2
        exit 1
    fi

    # Keep the file out of git status, else wt remove refuses the worktree as dirty
    # (.ddev/.gitignore only exists after the first ddev start).
    exclude=$(git rev-parse --git-path info/exclude)
    mkdir -p "$(dirname "$exclude")"
    if ! grep -qxF "/$local" "$exclude" 2>/dev/null; then
        echo "/$local" >> "$exclude"
    fi
fi

# TLD from the name, not the ticket: unique like the name, also for two branches of one ticket.
prefix=$(slug "$project-")
host=${prefix%-}
suffix=${name#"$prefix"}

# additional_fqdns don't get a TLD: the worktree would claim the main checkout's hosts.
if grep -qE '^additional_fqdns: *[^[ ]|^additional_fqdns: *\[ *[^] ]' .ddev/config.yaml \
    || grep -A1 '^additional_fqdns: *$' .ddev/config.yaml | grep -q '^ *- '; then
    echo "worktree pre-start: .ddev/config.yaml has additional_fqdns, the worktree would serve them too –" \
        "move them to additional_hostnames" >&2
fi

# No override_config: additional_hostnames of the main checkout are appended to, and get the worktree's TLD.
# The project's name as hostname serves the main site, the primary URL is <name>.<TLD>.
cat > "$local" <<EOF
$marker for this worktree
name: $name
project_tld: $suffix.$base_tld
additional_hostnames: ["$host"]
EOF
if [ -n "$upgrade" ]; then
    echo "DDEV project of this worktree: $name, now under $suffix.$base_tld – run ddev restart"
else
    echo "DDEV project of this worktree: $name, hosts under $suffix.$base_tld"
fi
